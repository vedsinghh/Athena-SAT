VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_publishable_or_anon_key
# Public site URL for auth confirmation emails (your Vercel domain, no trailing slash)
VITE_SITE_URL=https://your-app.vercel.app
# Google login: enable Google provider in Supabase → Authentication → Providers,
# add redirect URLs in Authentication → URL Configuration (site URL + http://localhost:5173 for dev),
# and set Google OAuth client ID/secret from Google Cloud Console.
# Optional: extra admin email that can open /reports for the compiled question-report inbox
# VITE_ADMIN_EMAIL=you@example.com
